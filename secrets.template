# sh-ollama secrets

# SearXNG secret key for session signing
SEARXNG_SECRET_KEY=''

# Ollama API key for opencode (typically "ollama" for local instances)
OPENCODE_OLLAMA_API_KEY='ollama'

# WEB-UI admin bootstrap (first-run only; ignored if user already exists)
WEBUI_ADMIN_EMAIL=""
WEBUI_ADMIN_PASSWORD=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')

# WEB-UI JWT signing key
WEBUI_SECRET_KEY=$(head -c 64 /dev/urandom | od -An -tx1 | tr -d ' \n')
